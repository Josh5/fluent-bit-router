#######################################################################
# FLUENT-BIT ROUTER — .env.example
#
# Copy to ".env" and adjust as needed.
# Booleans accept: true/false (case-insensitive). Empty means "unset".
#######################################################################

#@ Container Paths
#-  FLUENTBIT_STORAGE_PATH
#-    Host path for Fluent Bit persistent storage (chunks, DB, offsets).
FLUENTBIT_STORAGE_PATH=./appdata/fluent-bit/storage
#-  FLUENTBIT_CERTS_PATH
#-    Host path for TLS certificates (mounted into the container).
FLUENTBIT_CERTS_PATH=./appdata/fluent-bit/certs

#@ Core Fluent-Bit Settings
#-  HOST_HOSTNAME
#-    Hostname used inside Fluent Bit (self_hostname / cert CN where relevant).
HOST_HOSTNAME=fluent-bit-router
#-  ENVIRONMENT_NAME
#-    Deployment environment name appended as source_env.
ENVIRONMENT_NAME=
#-  ENVIRONMENT_TYPE
#-    Lifecycle or deployment class appended as source_env_type.
#-    Examples: homelab, test, staging, production.
ENVIRONMENT_TYPE=
#-  ENVIRONMENT_REGION
#-    Cloud-provider or physical region appended as source_env_region.
#-    Examples: ap-south-1, us-east-1, nz, uk.
ENVIRONMENT_REGION=
#-  ENVIRONMENT_ISOLATION_SCOPE
#-    Cross-cloud tenant/account/subscription and credential-isolation boundary.
#-    Example: staging-2026-03-08.
ENVIRONMENT_ISOLATION_SCOPE=
#-  INFRASTRUCTURE_PROVIDER
#-    Hosting provider used in record tags and instance discovery.
#-    Examples: aws, azure, self, linode.
INFRASTRUCTURE_PROVIDER=privatecloud
#-  INSTANCE_ID
#-    Stable host identifier appended as source_instance_id.
INSTANCE_ID=
#-  FLUENT_BIT_LOG_LEVEL
#-    Log verbosity of Fluent Bit: error | warn | info | debug | trace
FLUENT_BIT_LOG_LEVEL=info
#-  HTTP_SERVER_PORT
#-    Port for Fluent Bit’s internal HTTP metrics/health server (default 2020).
HTTP_SERVER_PORT=2020
#-  FLUENT_BIT_TAG_PREFIX
#-    Prefix applied to record tags for filtering/routing.
FLUENT_BIT_TAG_PREFIX=flb
#-  ENABLE_THREADED_NETWORK_INPUTS
#-    Enable multi-threading for network listener input plugins (Forward, HTTP) (default: false).
ENABLE_THREADED_NETWORK_INPUTS=false

#@ Storage & Buffering Settings
#-  FLUENT_STORAGE_MAX_CHUNKS_UP
#-    Maximum number of filesystem chunks kept in memory simultaneously (default: 128).
#-    Controls active chunk memory usage (~2MB per chunk; 128 chunks = ~256MB RAM).
FLUENT_STORAGE_MAX_CHUNKS_UP=128
#-  FLUENT_STORAGE_BACKLOG_MEM_LIMIT
#-    Memory limit for storage backlog engine when loading chunks from disk at startup (default: 20M).
FLUENT_STORAGE_BACKLOG_MEM_LIMIT=20M
#-  FLUENT_STORAGE_SYNC
#-    Storage synchronization mode: normal | full (default: normal).
FLUENT_STORAGE_SYNC=normal
#-  FLUENT_STORAGE_CHECKSUM
#-    Enable storage chunk checksum validation: on | off (default: off).
FLUENT_STORAGE_CHECKSUM=off
#-  FLUENT_INPUT_STORAGE_TYPE
#-    Input storage buffering mechanism: filesystem | memory (default: filesystem).
FLUENT_INPUT_STORAGE_TYPE=filesystem
#-  FLUENT_INPUT_MEM_BUF_LIMIT
#-    Memory buffer limit for inputs before filesystem writes (default: 64M).
FLUENT_INPUT_MEM_BUF_LIMIT=64M
#-  FLUENT_REWRITE_TAG_EMITTER_MEM_BUF_LIMIT
#-    Memory buffer limit for rewrite_tag emitter pipelines (default: 64M).
FLUENT_REWRITE_TAG_EMITTER_MEM_BUF_LIMIT=64M
#-  FLUENT_OUTPUT_BUFFER_STORAGE_TOTAL_LIMIT_SIZE
#-    Global fallback limit for output filesystem buffer queues (e.g. 3G, empty to use per-output defaults).
FLUENT_OUTPUT_BUFFER_STORAGE_TOTAL_LIMIT_SIZE=
#-  CONTAINER_MAX_LIFETIME_HOURS
#-    Optional max lifetime in hours before health check fails to trigger container restart (empty for unlimited).
CONTAINER_MAX_LIFETIME_HOURS=

#@ TLS Certificates
#-  USE_EXISTING_CERT
#-    Use an existing TLS certificate/key instead of generating new ones.
USE_EXISTING_CERT=false
#-  EXISTING_CERT_PATH
#-    Path INSIDE container to existing certificate file.
EXISTING_CERT_PATH=/fluent-bit-data/certs/1.pem
#-  EXISTING_KEY_PATH
#-    Path INSIDE container to existing private key file.
EXISTING_KEY_PATH=/fluent-bit-data/certs/1.key
#-  USE_CERTBOT_TO_GENERATE_KEY
#-    If true, run Certbot to issue a certificate via ACME challenge.
USE_CERTBOT_TO_GENERATE_KEY=false
#-  CERT_FQDN
#-    Fully qualified domain name used for certificate CN.
CERT_FQDN=
#-  CERT_EMAIL
#-    Email address for Certbot registration/renewal.
CERT_EMAIL=

#@ HTTP Input
#-  ENABLE_HTTP_INPUT
#-    Enable Fluent Bit HTTP input listener (ingest logs via HTTP).
ENABLE_HTTP_INPUT=false
#-  HTTP_INPUT_PORT
#-    Container port for HTTP input (default 24280).
HTTP_INPUT_PORT=24280

#@ Forward TLS Input
#-  ENABLE_TLS_FORWARD_INPUT
#-    Enable TLS-secured Forward input for receiving logs.
ENABLE_TLS_FORWARD_INPUT=false
#-  TLS_FORWARD_INPUT_PORT
#-    Container port for TLS Forward input (default 24224).
TLS_FORWARD_INPUT_PORT=24224
#-  TLS_FORWARD_INPUT_SHARED_KEY
#-    Shared key required for TLS Forward authentication.
TLS_FORWARD_INPUT_SHARED_KEY=123456789
#-  TLS_FORWARD_INPUT_VERIFY
#-    Verify client certificates? on|off (default: off).
TLS_FORWARD_INPUT_VERIFY=off

#@ Forward Plaintext Input
#-  ENABLE_PT_FORWARD_INPUT
#-    Enable plaintext Forward input (unsecured).
ENABLE_PT_FORWARD_INPUT=false
#-  PT_FORWARD_INPUT_PORT
#-    Container port for plaintext Forward input (default 24228).
PT_FORWARD_INPUT_PORT=24228

#@ Docker Forward Input
#-  ENABLE_DOCKER_FORWARD_INPUT
#-    Enable Docker container log forward input.
ENABLE_DOCKER_FORWARD_INPUT=false
#-  DOCKER_FORWARD_INPUT_PORT
#-    Container port for Docker container log forward input (default 24226).
DOCKER_FORWARD_INPUT_PORT=24226

#@ Systemd Journal Input
#-  ENABLE_SYSTEMD_INPUT
#-    Enable systemd journald / host system log input (requires host /var/log mounted).
ENABLE_SYSTEMD_INPUT=false
#-  SYSTEMD_FILTER_UNITS
#-    Optional comma-separated list of systemd unit regexes (e.g. "^gitops-.*\\.service$,^sshd\\.service$").
#-    Syslog process names are normalized to service-shaped unit names before filtering.
#-    If unset or empty, ALL systemd units are ingested.
SYSTEMD_FILTER_UNITS=

#@ Host Auth & Audit Log Inputs
#-  ENABLE_AUTH_LOG_INPUT
#-    Enable host SSH/auth log input (/host/var/log/auth.log or /host/var/log/secure).
ENABLE_AUTH_LOG_INPUT=false
#-  ENABLE_AUDIT_LOG_INPUT
#-    Enable host auditd log input (/host/var/log/audit/audit.log).
ENABLE_AUDIT_LOG_INPUT=false

#@ AWS Cloud Agent Log Inputs
#-  ENABLE_AWS_SSM_INPUT
#-    Enable AWS SSM Agent log input (/host/var/log/amazon/ssm).
ENABLE_AWS_SSM_INPUT=false
#-  ENABLE_AWS_ECS_INPUT
#-    Enable AWS ECS host log input (/host/var/log/ecs).
ENABLE_AWS_ECS_INPUT=false

#@ STDOUT Output
#-  ENABLE_STDOUT_OUTPUT
#-    Enable STDOUT output.
ENABLE_STDOUT_OUTPUT=false

#@ Forward TLS Output
#-  ENABLE_TLS_FORWARD_OUTPUT
#-    Enable sending logs to an upstream Fluent Bit/Fluentd via TLS Forward.
ENABLE_TLS_FORWARD_OUTPUT=false
#-  TLS_FORWARD_OUTPUT_HOST
#-    Hostname of the upstream TLS Forward receiver.
TLS_FORWARD_OUTPUT_HOST=
#-  TLS_FORWARD_OUTPUT_PORT
#-    Port of the upstream TLS Forward receiver.
TLS_FORWARD_OUTPUT_PORT=
#-  TLS_FORWARD_OUTPUT_SHARED_KEY
#-    Shared key for authenticating with upstream TLS Forward.
TLS_FORWARD_OUTPUT_SHARED_KEY=
#-  TLS_FORWARD_OUTPUT_VERIFY
#-    Verify TLS certificates from the upstream server? on|off.
TLS_FORWARD_OUTPUT_VERIFY=off
#-  TLS_FORWARD_OUTPUT_BUFFER_STORAGE_TOTAL_LIMIT_SIZE
#-    Maximum filesystem buffer queue size for TLS Forward output (default: 3G).
TLS_FORWARD_OUTPUT_BUFFER_STORAGE_TOTAL_LIMIT_SIZE=3G
#-  TLS_FORWARD_OUTPUT_RETRY_LIMIT
#-    Retry limit for TLS Forward output: integer or false for unlimited retries (default: false).
TLS_FORWARD_OUTPUT_RETRY_LIMIT=false

#@ Forward Plaintext Output
#-  ENABLE_PT_FORWARD_OUTPUT
#-    Enable sending logs to an upstream Fluent Bit/Fluentd via plaintext Forward.
ENABLE_PT_FORWARD_OUTPUT=false
#-  PT_FORWARD_OUTPUT_HOST
#-    Hostname of the upstream plaintext Forward receiver.
PT_FORWARD_OUTPUT_HOST=
#-  PT_FORWARD_OUTPUT_PORT
#-    Port of the upstream plaintext Forward receiver.
PT_FORWARD_OUTPUT_PORT=
#-  PT_FORWARD_OUTPUT_BUFFER_STORAGE_TOTAL_LIMIT_SIZE
#-    Maximum filesystem buffer queue size for PT Forward output (default: 3G).
PT_FORWARD_OUTPUT_BUFFER_STORAGE_TOTAL_LIMIT_SIZE=3G
#-  PT_FORWARD_OUTPUT_RETRY_LIMIT
#-    Retry limit for PT Forward output: integer or false for unlimited retries (default: false).
PT_FORWARD_OUTPUT_RETRY_LIMIT=false

#@ Grafana Loki Output
#-  ENABLE_GRAFANA_LOKI_OUTPUT
#-    Enable output to Grafana Loki.
ENABLE_GRAFANA_LOKI_OUTPUT=false
#-  GRAFANA_LOKI_HOST
#-    Hostname/service of the Loki gateway (inside the Swarm network).
GRAFANA_LOKI_HOST=loki
#-  GRAFANA_LOKI_PORT
#-    Loki HTTP port (default: 3100).
GRAFANA_LOKI_PORT=3100
#-  GRAFANA_LOKI_URI
#-    Loki push path (default: /loki/api/v1/push).
GRAFANA_LOKI_URI=/loki/api/v1/push
#-  GRAFANA_LOKI_BUFFER_STORAGE_TOTAL_LIMIT_SIZE
#-    Maximum filesystem buffer queue size for Loki output (default: 3G).
GRAFANA_LOKI_BUFFER_STORAGE_TOTAL_LIMIT_SIZE=3G
#-  GRAFANA_LOKI_RETRY_LIMIT
#-    Retry limit for Loki output before discarding failed chunk: integer or false (default: 10).
GRAFANA_LOKI_RETRY_LIMIT=10

#@ OpenObserve HTTP Output
#-  ENABLE_OPENOBSERVE_HTTP_OUTPUT
#-    Enable sending logs to OpenObserve via HTTP JSON streaming.
ENABLE_OPENOBSERVE_HTTP_OUTPUT=false
#-  OPENOBSERVE_HTTP_HOST
#-    Hostname or service name of the OpenObserve server.
OPENOBSERVE_HTTP_HOST=openobserve
#-  OPENOBSERVE_HTTP_PORT
#-    Port of the OpenObserve HTTP server (default: 5080).
OPENOBSERVE_HTTP_PORT=5080
#-  OPENOBSERVE_HTTP_URI
#-    Ingestion endpoint path for OpenObserve (default: /api/default/default/_json).
OPENOBSERVE_HTTP_URI=/api/default/default/_json
#-  OPENOBSERVE_HTTP_TLS
#-    Enable TLS/HTTPS connection for OpenObserve: on | off (default: off).
OPENOBSERVE_HTTP_TLS=off
#-  OPENOBSERVE_HTTP_USER
#-    Basic authentication username (e.g. user email) for OpenObserve.
OPENOBSERVE_HTTP_USER=
#-  OPENOBSERVE_HTTP_PASSWD
#-    Basic authentication password or token for OpenObserve.
OPENOBSERVE_HTTP_PASSWD=
#-  OPENOBSERVE_HTTP_BUFFER_STORAGE_TOTAL_LIMIT_SIZE
#-    Maximum filesystem buffer queue size for OpenObserve output (default: 5G).
OPENOBSERVE_HTTP_BUFFER_STORAGE_TOTAL_LIMIT_SIZE=5G
#-  OPENOBSERVE_HTTP_RETRY_LIMIT
#-    Retry limit for OpenObserve output: integer or false for unlimited retries (default: false).
OPENOBSERVE_HTTP_RETRY_LIMIT=false

#@ Graylog GELF Output
#-  ENABLE_GRAYLOG_GELF_OUTPUT
#-    Enable sending logs to Graylog via GELF.
ENABLE_GRAYLOG_GELF_OUTPUT=false
#-  GRAYLOG_GELF_HOST
#-    Hostname or service name of the Graylog GELF input.
GRAYLOG_GELF_HOST=graylog
#-  GRAYLOG_GELF_PORT
#-    Port of the Graylog GELF input (usually 12201).
GRAYLOG_GELF_PORT=12201
#-  GRAYLOG_GELF_MODE
#-    Transport protocol for GELF: tcp | udp (default: tcp).
GRAYLOG_GELF_MODE=tcp
#-  GRAYLOG_GELF_BUFFER_STORAGE_TOTAL_LIMIT_SIZE
#-    Maximum filesystem buffer queue size for Graylog GELF output (default: 2G).
GRAYLOG_GELF_BUFFER_STORAGE_TOTAL_LIMIT_SIZE=2G
#-  GRAYLOG_GELF_RETRY_LIMIT
#-    Retry limit for Graylog GELF output before dropping failed chunk (default: 6).
GRAYLOG_GELF_RETRY_LIMIT=6

#@ S3 Cold Storage Output
#-  ENABLE_S3_BUCKET_COLD_STORAGE_OUTPUT
#-    Enable archiving logs to an S3 bucket (credentials must be provided by the runtime, e.g., env/role).
ENABLE_S3_BUCKET_COLD_STORAGE_OUTPUT=false
#-  AWS_COLD_STORAGE_BUCKET_NAME
#-    Name of the S3 bucket used for cold storage.
AWS_COLD_STORAGE_BUCKET_NAME=
#-  AWS_COLD_STORAGE_BUCKET_REGION
#-    AWS region of the S3 bucket (e.g., ap-southeast-2).
AWS_COLD_STORAGE_BUCKET_REGION=
#-  AWS_COLD_STORAGE_BUFFER_STORE_DIR_LIMIT_SIZE
#-    Maximum disk space limit for local S3 multipart buffer directory (default: 10G).
AWS_COLD_STORAGE_BUFFER_STORE_DIR_LIMIT_SIZE=10G
#-  AWS_COLD_STORAGE_RETRY_LIMIT
#-    Retry limit for S3 uploads before failing chunk: integer or false (default: 5).
AWS_COLD_STORAGE_RETRY_LIMIT=5
